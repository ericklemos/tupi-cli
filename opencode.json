{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git", "opencode-antigravity-auth@2.1.1"],
  "mcp": {
    "servers": {
      "brain-tools": {
        "type": "local",
        "command": [
    "/home/desktop/Documents/projects/brain_tools/target/release/brain-tools",
    "--root-dir",
    "/home/desktop/Documents/projects/tupi-cli"
  ]
      }
    }
  },
  "agents": {
    "brain-only": {
      "description": "Lê e navega o projeto apenas pelo MCP brain-tools",
      "mode": "primary",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },

        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "brain-tools_*", "resource": "*", "effect": "allow" },
        { "action": "opencode_list_mcp_resources", "resource": "*", "effect": "allow" },
        { "action": "opencode_read_mcp_resource", "resource": "brain-tools:*", "effect": "allow" }
      ]
    }
  }
}
