// Limite de passos de tool call por turno.
// Cada passo é uma resposta do modelo que pode conter uma ou mais chamadas;
// ao atingir o limite, as chamadas ainda não executadas são encerradas.
//
// Número medido, não palpite: o split provider×tool da telemetria real
// (`tupi telemetry`, crates/tupi/src/telemetry_report.rs; probe em
// crates/tupi/tests/turn_baseline.rs) mostra turno interativo de 12 passos a
// ~5,4 s por passo, 48% do tempo no provedor e 46% nas tools — o teto é
// multiplicador do pior caso, e o pior caso não é o uso observado.
// 30 é o default de código (DEFAULT_MAX_TOOL_STEPS, crates/tupi/src/tool_config.rs)
// e dá 2,5× de folga sobre os 12 passos medidos: o freio avisa a partir de 18
// (60%) e a última chamada, sem tools, sai no passo 30. Subir de novo exige
// pior caso medido, não margem imaginada.
(
    max_tool_steps: 30,
    expose_all: true,
    // Binários liberados na tool `shell`. Presente e não vazia, esta lista
    // vence `ai.project.json` → `shell.allow`; ausente ou vazia, vale a do
    // projeto e, sem ela, o padrão do código (`git` e `jq`,
    // crates/tupi-tools/src/tools/shell/mod.rs).
    //
    // Fica no mínimo de propósito: nada aqui tem tool equivalente nem executa
    // outro comando. Listar grep, ls, cat, sed, find ou curl não reabre nada —
    // o bloqueio é do binário, não da lista — e wrappers (sh, bash, env,
    // xargs, make) e `cargo` recusam sempre; `cargo fmt` sai pela regra fixa
    // do formatador, sem precisar de lista.
    shell: (
        allow: [
            // Histórico e diff: só subcomando de leitura.
            "git",
            // Inspeção de JSON (ai.project.json, configs).
            "jq",
            // Formatação Rust direta, fora do `cargo fmt`.
            "rustfmt",
            // Bytes de arquivo e diretório: nem `map` nem `read` dão tamanho.
            "stat",
            "du",
            // Sistema e arquitetura do ambiente, que a tool `env` não expõe.
            "uname",
            "colab"
        ],
    ),
)
